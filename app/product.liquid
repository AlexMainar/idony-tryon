{%- comment -%} /sections/product-template {%- endcomment -%}
{%- liquid
  assign bg_color = section.settings.bg_color
  assign gradient = section.settings.gradient | default: 'none'
  assign section_width = section.settings.width
  assign section_id = 'productTemplate--' | append: section.id
  assign selector_id = '#' | append: section_id
  assign animation_anchor = selector_id
  assign animations_enabled = settings.animations_enabled
  assign bg_color_set = false

  if gradient != 'none' or bg_color.alpha != 0.0 and bg_color != ''
    assign bg_color_set = true
  endif
-%}

{%- style -%}
  {{ selector_id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;

    {% if bg_color_set -%}
      {%- if gradient != 'none' -%}
        --bg: {{ gradient }};
      {%- else -%}
        --bg: {{ bg_color }};
      {%- endif -%}
    {%- endif %}
  }
{%- endstyle -%}

<section
  id="{{ section_id }}"
  class="section-padding product-single{%- render 'button-fallback-classes', primary_color: settings.atc_button_color, secondary_color: settings.buynow_btn_color, section_bg_color: bg_color -%}"
  data-enable-history-state="true"
  data-section-type="product-template"
  data-section-id="{{ section.id }}"
  data-sticky-enabled="{{ section.settings.product_sticky_enable }}"
  data-tall-layout="{% if section.settings.image_layout == 'carousel' %}false{% else %}true{% endif %}"
  {% if animations_enabled %}
    data-aos-intersection="0.01"
  {% endif %}
>
  <div class="{{ section_width }}">
    {%- render 'product', animation_anchor: animation_anchor -%}
  </div>

  {% if product.tags contains "tryon" %}
    <div
      id="tryon-root"
      data-tryon-root
      style="
        position: absolute;
        display: none;
        z-index: 9999;
        pointer-events: auto;
      "
    >
      <div id="tryon-loading" aria-hidden="false">
        <div class="tryon-spinner"></div>
      </div>
      <div
        id="tryon-frame-container"
        data-tryon-container
        style="
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
        "
      >
        <iframe
          id="tryon-frame"
          src=""
          allow="camera"
          allowfullscreen
          style="width:100%;height:100%;border:0;"
        ></iframe>
      </div>
    </div>
  {% endif %}

<script>
  (function () {
    if (window.__IDONY_TRYON_INIT__) {
      console.log("tryon script already initialized, skipping");
      return;
    }
    window.__IDONY_TRYON_INIT__ = true;

    const TRYON_ROOT = document.querySelector("#tryon-root");
    let currentMediaSpace = null;
    let tryonOpen = false;
    let mutationSyncTimeout = null;
    let variantSyncTimeout = null;
    let reanchorBlockedUntil = 0;
    let lastRect = null;
    const MOVE_EPS = 2;
    
    if (!TRYON_ROOT) {
      console.log("❌ tryon-root missing");
      return;
    }
    TRYON_ROOT.style.display = "none";
    TRYON_ROOT.style.pointerEvents = "none";

    const getIframe = () => document.querySelector("#tryon-frame");

    {%- comment -%} MOBILE RESPONSIVE {%- endcomment -%}
    const MOBILE_BP = 768;
    let mobileShadeBar = null;

    function isMobileTryon() {
      return window.matchMedia(`(max-width: ${MOBILE_BP}px)`).matches;
    }

    function getColorSwatchLabels() {
      const form = document.querySelector('form[action="/cart/add"]') || document;
      const radios = Array.from(form.querySelectorAll('input[type="radio"][id]'));
      return radios
        .map((input) => document.querySelector(`label[for="${CSS.escape(input.id)}"]`))
        .filter((label) =>
          label &&
          (label.classList.contains("swatch__label") ||
            label.dataset?.swatchVariant ||
            label.dataset?.swatch ||
            label.dataset?.variantTitle)
        );
    }

    function removeMobileShadeBar() {
      if (mobileShadeBar && mobileShadeBar.parentNode) {
        mobileShadeBar.parentNode.removeChild(mobileShadeBar);
      }
      mobileShadeBar = null;
    }

    function buildMobileShadeBar() {
      removeMobileShadeBar();

      const labels = getColorSwatchLabels();
      if (!labels.length) return;

      mobileShadeBar = document.createElement("div");
      mobileShadeBar.id = "tryon-mobile-shades";
      const track = document.createElement("div");
      track.className = "tryon-mobile-shades__track";

      labels.forEach((label) => {
        const forId = label.getAttribute("for");
        const input = forId ? document.getElementById(forId) : null;
        if (!(input instanceof HTMLInputElement)) return;

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "tryon-mobile-shade";
        btn.dataset.for = forId || "";
        btn.textContent =
          label.dataset?.swatch?.trim() ||
          label.dataset?.variantTitle?.trim() ||
          label.textContent?.trim() ||
          "Shade";

        btn.addEventListener("click", () => {
          label.click();
          queueVariantSync(true);
          syncMobileShadeBar();
        });

        track.appendChild(btn);
      });

      mobileShadeBar.appendChild(track);
      document.body.appendChild(mobileShadeBar);
      syncMobileShadeBar();
    }

    function syncMobileShadeBar() {
      if (!mobileShadeBar) return;
      const buttons = mobileShadeBar.querySelectorAll(".tryon-mobile-shade");
      buttons.forEach((btn) => {
        const forId = btn.getAttribute("data-for");
        const input = forId ? document.getElementById(forId) : null;
        const selected = input instanceof HTMLInputElement && input.checked;
        btn.classList.toggle("is-selected", !!selected);
      });
    }
    {%- comment -%} END MOBILE RESPONSIVE {%- endcomment -%}

    function pickBestMediaSpaceByOverlap() {
      const activeSpaces = [
        ...document.querySelectorAll(
          ".product-gallery__media-slide:not(.media--hidden) .product-gallery__media-space"
        ),
      ];
      const spaces = activeSpaces.length
        ? activeSpaces
        : [...document.querySelectorAll(".product-gallery__media-space")];
      const vw = window.innerWidth;
      const vh = window.innerHeight;

      let best = null;
      let bestScore = Number.NEGATIVE_INFINITY;
      let fallback = null;
      let fallbackOverlap = 0;
      const viewportCenterX = vw / 2;
      const viewportCenterY = vh / 2;

      for (const el of spaces) {
        const r = el.getBoundingClientRect();
        const ow = Math.max(0, Math.min(r.right, vw) - Math.max(r.left, 0));
        const oh = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
        const overlap = ow * oh;
        if (overlap <= 0) continue;

        if (overlap > fallbackOverlap) {
          fallbackOverlap = overlap;
          fallback = el;
        }

        const centerX = r.left + r.width / 2;
        const centerY = r.top + r.height / 2;
        const distance = Math.hypot(centerX - viewportCenterX, centerY - viewportCenterY);
        const visibleRatio = overlap / Math.max(1, r.width * r.height);
        if (visibleRatio < 0.25) continue;

        const score = visibleRatio * 1_000_000 - distance;
        if (score > bestScore) {
          bestScore = score;
          best = el;
        }
      }

      return best || fallback;
    }

    function getViewportOverlapArea(el) {
      if (!el || !el.isConnected) return 0;
      const r = el.getBoundingClientRect();
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const ow = Math.max(0, Math.min(r.right, vw) - Math.max(r.left, 0));
      const oh = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
      return ow * oh;
    }

    function getViewportOverlapRatio(el) {
      if (!el || !el.isConnected) return 0;
      const r = el.getBoundingClientRect();
      const total = Math.max(1, r.width * r.height);
      return getViewportOverlapArea(el) / total;
    }
    
    function refreshCurrentMediaSpace() {
      if (!tryonOpen || isMobileTryon()) return;

      if (
        Date.now() < reanchorBlockedUntil &&
        currentMediaSpace &&
        currentMediaSpace.isConnected
      ) {
        return;
      }

      if (
        currentMediaSpace &&
        currentMediaSpace.isConnected &&
        getViewportOverlapArea(currentMediaSpace) > 0 &&
        getViewportOverlapRatio(currentMediaSpace) > 0.45
      ) {
        return;
      }

      const next = pickBestMediaSpaceByOverlap();
      if (!next) return;
      if (next === currentMediaSpace) return;

      currentMediaSpace = next;
      lastRect = null;
    }

    function getDesktopAnchorElement() {
      if (!currentMediaSpace || !currentMediaSpace.isConnected) return null;
      return currentMediaSpace;
    }


    function closeTryon() {
      const iframe = getIframe();
      if (iframe?.contentWindow) {
        iframe.contentWindow.postMessage({ type: "TRYON_STOP_CAMERA" }, "*");
      }

      TRYON_ROOT.style.display = "none";
      TRYON_ROOT.style.pointerEvents = "none";
      TRYON_ROOT.style.position = "";
      TRYON_ROOT.style.left = "";
      TRYON_ROOT.style.top = "";
      TRYON_ROOT.style.width = "";
      TRYON_ROOT.style.height = "";
      TRYON_ROOT.style.transform = "";
      TRYON_ROOT.style.inset = "";
      TRYON_ROOT.style.zIndex = "";
      TRYON_ROOT.style.transition = "";

      document.body.classList.remove("tryon-open");

      document.body.classList.remove("tryon-mobile-open");
      removeMobileShadeBar();

      // Keep root mounted in body after first open; re-parenting can reinitialize
      // the iframe and unintentionally restart the camera after close.

      if (mutationSyncTimeout) {
        clearTimeout(mutationSyncTimeout);
        mutationSyncTimeout = null;
      }
      if (variantSyncTimeout) {
        clearTimeout(variantSyncTimeout);
        variantSyncTimeout = null;
      }

      tryonOpen = false;
      currentMediaSpace = null;
      reanchorBlockedUntil = 0;
      lastRect = null;
    }

    function syncTryonPosition() {
      if (!tryonOpen || isMobileTryon()) return;

      if (!currentMediaSpace || !currentMediaSpace.isConnected) {
        refreshCurrentMediaSpace();
      }
      if (!currentMediaSpace) return;

      const anchorEl = getDesktopAnchorElement();
      if (!anchorEl) return;

      const rect = anchorEl.getBoundingClientRect();
      const nextRect = {
        left: Math.max(0, Math.round(rect.left)),
        top: Math.max(0, Math.round(rect.top)),
        width: Math.max(0, Math.round(rect.width)),
        height: Math.max(0, Math.round(rect.height)),
      };
      if (nextRect.width < 40 || nextRect.height < 40) return;
      if (lastRect) {
        const dx = Math.abs(nextRect.left - lastRect.left);
        const dy = Math.abs(nextRect.top - lastRect.top);
        const dw = Math.abs(nextRect.width - lastRect.width);
        const dh = Math.abs(nextRect.height - lastRect.height);
        if (dx <= MOVE_EPS && dy <= MOVE_EPS && dw <= MOVE_EPS && dh <= MOVE_EPS) {
          return;
        }
      }
      lastRect = nextRect;

      TRYON_ROOT.style.inset = "auto";
      TRYON_ROOT.style.position = "fixed";
      TRYON_ROOT.style.left = `${nextRect.left}px`;
      TRYON_ROOT.style.top = `${nextRect.top}px`;
      TRYON_ROOT.style.width = `${nextRect.width}px`;
      TRYON_ROOT.style.height = `${nextRect.height}px`;
      TRYON_ROOT.style.transform = "none";
      TRYON_ROOT.style.transition = "none";
      TRYON_ROOT.style.zIndex = "100";
      TRYON_ROOT.style.pointerEvents = "auto";
    }

    function mountTryonTo(mediaSpace) {
      if (!mediaSpace || !TRYON_ROOT) return;

      if (isMobileTryon()) {
        document.body.classList.add("tryon-mobile-open");
        document.body.classList.add("tryon-open");
        TRYON_ROOT.style.top = "0";        // reset stale top
        TRYON_ROOT.style.transform = "none"; // reset stale transform

        buildMobileShadeBar();

        // move root to body to avoid gallery transforms on mobile
        if (TRYON_ROOT.parentElement !== document.body) {
          document.body.appendChild(TRYON_ROOT);
        }

        TRYON_ROOT.style.display = "block";
        TRYON_ROOT.style.pointerEvents = "auto";
        TRYON_ROOT.style.position = "fixed";
        TRYON_ROOT.style.inset = "";      // 🔥 CLEAR CSS inset
        TRYON_ROOT.style.bottom = "";
        TRYON_ROOT.style.right = "";
        TRYON_ROOT.style.left = "0";
        TRYON_ROOT.style.top = "0";
        TRYON_ROOT.style.width = "100vw";
        TRYON_ROOT.style.height = "100dvh";
        TRYON_ROOT.style.zIndex = "9999";

        tryonOpen = true;
        return; // skip desktop logic
      }

      currentMediaSpace = mediaSpace || pickBestMediaSpaceByOverlap();

      // IMPORTANT: desktop root must stay in body (never move between media-space clones)
      if (TRYON_ROOT.parentElement !== document.body) {
        document.body.appendChild(TRYON_ROOT);
      }

      TRYON_ROOT.style.display = "block";
      TRYON_ROOT.style.pointerEvents = "auto";
      TRYON_ROOT.style.position = "fixed";
      TRYON_ROOT.style.inset = "auto";
      TRYON_ROOT.style.transform = "none";
      TRYON_ROOT.style.zIndex = "100";

      document.body.classList.add("tryon-open");
      tryonOpen = true;
      syncTryonPosition();
      requestAnimationFrame(syncTryonPosition);
    }

    const gallery =
      document.querySelector(".product-gallery") ||
      document.querySelector(".product-gallery__media") ||
      document.querySelector(".product-gallery__media-space")?.parentElement;

    if (gallery) {
      const obs = new MutationObserver(() => {
        if (!tryonOpen || isMobileTryon()) return;
        if (mutationSyncTimeout) {
          clearTimeout(mutationSyncTimeout);
        }
        mutationSyncTimeout = window.setTimeout(() => {
          mutationSyncTimeout = null;
          // Re-pick only when current target is invalid; avoids slideshow chasing.
          refreshCurrentMediaSpace();
          requestAnimationFrame(syncTryonPosition);
        }, 160);
      });
      obs.observe(gallery, { childList: true, subtree: true });
    }

    const scheduleDesktopPositionSync = () => {
      if (!tryonOpen || isMobileTryon()) return;
      requestAnimationFrame(syncTryonPosition);
    };
    window.addEventListener("resize", scheduleDesktopPositionSync);
    window.addEventListener("orientationchange", scheduleDesktopPositionSync);
    window.addEventListener("scroll", scheduleDesktopPositionSync, { passive: true });

    let lastVariantId = null;

    function getSelectedSwatchLabel() {
      const checked =
        document.querySelector(".swatch__input:checked") ||
        document.querySelector('input[type="radio"][name*="Color"]:checked') ||
        document.querySelector('input[type="radio"][name*="colour"]:checked');

      if (checked && checked.id) {
        const label = document.querySelector(`label[for="${CSS.escape(checked.id)}"]`);
        if (label) return label;
      }

      return (
        document.querySelector(".swatch__label.is-selected") ||
        document.querySelector(".swatch__label[aria-checked='true']")
      );
    }

    function getVariantTitle() {
      const select = document.querySelector('form[action="/cart/add"] select[name="id"]');
      if (select?.selectedOptions?.length) return select.selectedOptions[0].text.trim();

      const label = getSelectedSwatchLabel();
      return (
        label?.dataset?.swatch?.trim() ||
        label?.dataset?.variantTitle?.trim() ||
        null
      );
    }

    function getVariantId() {
      const label = getSelectedSwatchLabel();
      const swatchVariant = label?.dataset?.swatchVariant || null;

      const fromUrl = new URLSearchParams(window.location.search).get("variant");
      const input = document.querySelector('form[action="/cart/add"] [name="id"]');
      const fromInput = input?.value || null;

      return swatchVariant || fromInput || fromUrl;
    }

    function sendVariantToIframe(force = false) {
      const newVariantId = getVariantId();
      const newVariantTitle = getVariantTitle();
      const iframe = getIframe();

      if (!newVariantId || !iframe?.contentWindow) return;
      if (!force && newVariantId === lastVariantId) return;

      lastVariantId = newVariantId;
      iframe.contentWindow.postMessage(
        { type: "COLOR_CHANGED", variantId: newVariantId, variantTitle: newVariantTitle },
        "*"
      );
      console.log("Color changed → sending variant:", newVariantId, newVariantTitle);
    }

    function queueVariantSync(force = false) {
      // Freeze desktop target switching during Shopify gallery transition.
      reanchorBlockedUntil = Date.now() + 420;
      if (variantSyncTimeout) {
        clearTimeout(variantSyncTimeout);
      }
      variantSyncTimeout = window.setTimeout(() => {
        variantSyncTimeout = null;
        sendVariantToIframe(force);
      }, 80);
    }

    document.addEventListener("change", function (e) {
      if (!tryonOpen) return;
      const t = e.target;
      if (!(t instanceof HTMLInputElement || t instanceof HTMLSelectElement)) return;
      if (
        t.name === "id" ||
        t.name.includes("Color") ||
        t.name.includes("colour")
      ) {
        queueVariantSync(true);
      }
    }, true);

    document.addEventListener("click", function (e) {
      const btn = e.target.closest("[data-tryon-button]");
      if (!btn) return;

      e.preventDefault();
      e.stopPropagation();

      currentMediaSpace = btn.closest(".product-gallery__media-space");
      if (!currentMediaSpace) return;

      const loading = document.querySelector("#tryon-loading");
      if (loading) loading.classList.remove("is-hidden");

      const handle = btn.dataset.productHandle;
      const variant = decodeURIComponent(btn.dataset.variantTitle || "");
      const iframe = getIframe();

      if (iframe && !iframe.getAttribute("src")) {
        iframe.src =
          "https://idonytryon.eu.ngrok.io/tryon" +
          "?handle=" + encodeURIComponent(handle || "") +
          "&variant=" + encodeURIComponent(variant || "");
      }
    
      mountTryonTo(currentMediaSpace);

      lastVariantId = null;
      queueVariantSync(true);
    });

    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      closeTryon();
    });

    window.addEventListener("message", (event) => {
      if (event?.data?.type === "TRYON_READY") {
          const loading = document.querySelector("#tryon-loading");
          if (loading) loading.classList.add("is-hidden");
        }
      if (event?.data?.type !== "TRYON_CLOSE") return;
      closeTryon();
    });
  })();
</script>

</section>

{%- assign current_variant = product.selected_or_first_available_variant -%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | strip_html | json }},
    "url": {{ shop.url | append: product.url | json }},
    {%- if product.featured_media -%}
      "image": [
        {{ product.featured_media | image_url: width: product.featured_media.preview_image.width  | prepend: "https:" | json }}
      ],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    {%- if current_variant.sku != blank -%}
      "sku": {{ current_variant.sku | json }},
    {%- endif -%}
    "brand": {
      "@type": "Thing",
      "name": {{ product.vendor | json }}
    },
    {%- if current_variant.barcode -%}
      "gtin8": "{{ product.variants.first.barcode }}",
    {%- endif -%}
    {%- if current_variant.barcode.size == 12 -%}
      "gtin12": "{{ product.variants.first.barcode }}",
    {%- endif -%}
    {%- if current_variant.barcode.size == 13 -%}
      "gtin13": "{{ product.variants.first.barcode }}",
    {%- endif -%}
    {%- if current_variant.barcode.size == 14 -%}
      "gtin14": "{{ product.variants.first.barcode }}",
    {%- endif -%}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          "url" : {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{%- comment -%}  
  <!-- ✅ Sticky Add to Cart (mobile only) -->
  <div class="floating-add-to-cart-bar">
    <button type="button" class="floating-atc-btn">
      AÑADIR AL CARRITO
    </button>
  </div>

  <script>
  document.addEventListener("DOMContentLoaded", function () {
    const floatingBtn = document.querySelector(".floating-atc-btn");
    if (!floatingBtn) return;

    floatingBtn.addEventListener("click", function () {
      const realAtcBtn = document.querySelector('[data-add-to-cart]');
      if (realAtcBtn) realAtcBtn.click();
    });
  });
  </script>
{%- endcomment -%}

{% schema %}
{
  "name": "Product pages",
  "class": "shopify-section--product",
  "settings": [
    {
      "type": "header",
      "content": "Product description"
    },
    {
      "type": "checkbox",
      "id": "product_sticky_enable",
      "label": "Enable sticky form",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_layout",
      "label": "Desktop layout",
      "options": [
        {"value": "grid", "label": "Grid"},
        {"value": "stacked", "label": "Stacked"},
        {"value": "carousel", "label": "Carousel with thumbnails"}
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "options": [
        {"value": "standard", "label": "Standard"},
        {"value": "large", "label": "Large"}
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "product_image_aspect_ratio",
      "label": "Equal image aspect ratio",
      "default": false,
      "info": "Set products in the ‘Grid’ layout to the same aspect ratio"
    },
    {
      "type": "header",
      "content": "Media",
      "info": "Learn more about [media types](https://help.shopify.com/manual/products/product-media)"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Enable video looping",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background"
    },
    {
      "type": "color_background",
      "id": "gradient",
      "label": "Overlay gradient"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper",
      "options": [
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Page width"}
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title and price",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "subheading",
          "label": "Navigation",
          "default": "breadcrumbs",
          "options": [
            {"value": "none", "label": "None"},
            {"value": "breadcrumbs", "label": "Breadcrumbs"},
            {"value": "collection", "label": "Collection"},
            {"value": "vendor", "label": "Vendor"}
          ]
        },
        {
          "type": "header",
          "content": "Text"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Title size",
          "default": 100,
          "min": 70,
          "max": 150,
          "step": 5,
          "unit": "%"
        },
